// Plantilla de posts de Instagram para panduck (typst). Cada encabezado # del
// markdown es un post (una pagina). El filtro instagram-posts.lua parte el cuerpo
// en llamadas #post(...)[...], resuelve el color de texto por contraste y traduce
// columnas e imagenes. La geometria, la fuente y el pie se configuran desde
// head.yaml; cada post puede sobreescribir fondo, imagen y color de texto desde
// los atributos del encabezado.
//
// Reemplaza la plantilla typst por defecto de pandoc, asi que reincluye a mano
// las definiciones que el writer presupone (blockquote, horizontalrule, endnote).

#let _w = $if(width)$$width$$else$10cm$endif$
#let _h = $if(height)$$height$$else$12.5cm$endif$
#let _margin = $if(margin)$$margin$$else$0.9cm$endif$
#let _fontsize = $if(fontsize)$$fontsize$$else$14pt$endif$
// fuente para los spans .sff/.sans. El nombre es el typographic family que ve
// typst (revisar con `typst fonts`), no necesariamente el de fontconfig.
#let _sansfont = $if(sansfont)$"$sansfont$"$else$"Liberation Sans"$endif$
#let _leading = $if(leading)$$leading$$else$0.7em$endif$
#let _footer = [$if(footer)$$footer$$endif$]
#let _header = [$if(header)$$header$$endif$]
// donde va la marca en cada franja; el numero se pone en el borde contrario
#let _header_align = "$if(header-align)$$header-align$$else$center$endif$"
#let _footer_align = "$if(footer-align)$$footer-align$$else$center$endif$"
// numero de post (n / total) al pie; se apaga con `no-slide-number: true`
#let _slidenum = $if(no-slide-number)$false$else$true$endif$

#set text(
  font: ($if(mainfont)$"$mainfont$"$else$"Liberation Sans"$endif$,),
  size: _fontsize,
)
#set par(justify: false, leading: _leading)
#show heading: it => it.body

// span .sff/.sans -> fuente secundaria configurable
#let sff(body) = text(font: _sansfont, body)

// Fila de imagenes (::: row del markdown, que el filtro traduce a esta llamada).
// Cada pieza es (path, circle, factor), donde factor viene del width/height en %
// que lleve la imagen. Con `height` todas las piezas se igualan a esa altura y
// factor la escala; sin `height` las columnas reparten el ancho (factor fija el
// ancho de esa columna). Un gap negativo las traslapa, y como el stack dibuja en
// orden, cada imagen queda sobre la anterior.
#let _row-piece-h(p, h) = {
  let alto = if p.factor == none { h } else { h * p.factor }
  if p.circle {
    box(clip: true, radius: 50%, width: alto, height: alto,
        image(p.path, width: 100%, height: 100%, fit: "cover"))
  } else {
    box(image(p.path, height: alto))
  }
}

#let _row-piece-w(p) = if p.circle {
  layout(s => box(clip: true, radius: 50%, width: s.width, height: s.width,
                  image(p.path, width: 100%, height: 100%, fit: "cover")))
} else {
  image(p.path, width: 100%)
}

#let row(gap: 0.4em, height: none, width: 100%, ..pieces) = {
  let ps = pieces.pos()
  align(center, block(width: width, if height != none {
    stack(dir: ltr, spacing: gap,
      ..ps.map(p => box(height: height, align(horizon, _row-piece-h(p, height)))))
  } else {
    grid(columns: ps.map(p => if p.factor == none { 1fr } else { p.factor * 100% }),
      column-gutter: gap, align: bottom + center, ..ps.map(_row-piece-w))
  }))
}

#let blockquote(body) = block(inset: (left: 1.5em))[#body]
#let horizontalrule = align(center)[#v(0.3em) #text(size: 1.3em)[\u{2042}] #v(0.3em)]
#let endnote(num, contents) = stack(dir: ltr, spacing: 3pt, super[#num], contents)
#show terms: it => it.children.map(c => [#strong[#c.term] #block(inset: (left: 1.5em))[#c.description]]).join()

// Franja i de una imagen ancha repartida entre n posts (carrusel continuo): la
// imagen se dibuja del porte de las n paginas juntas, corrida i paginas hacia la
// izquierda y recortada al borde. Al deslizar en Instagram, las franjas se leen
// como una sola foto.
//
// La foto casi nunca viene en la proporcion exacta de la tira (n * ancho x alto),
// asi que la escala y el encuadre se calculan a mano en vez de dejarselos a
// `fit: "cover"`: se escala hasta cubrir la tira por el lado que falte y el
// sobrante se reparte segun x e y (0% arriba/izquierda, 50% centrado, 100%
// abajo/derecha). Ese encuadre es el mismo para las n franjas, si no la costura
// entre posts no calza.
#let _panorama(path, n, i, x: 50%, y: 50%) = layout(sz => context {
  let tira = n * sz.width
  let natural = measure(image(path))
  let escala = calc.max(tira / natural.width, sz.height / natural.height)
  let ancho = natural.width * escala
  let alto = natural.height * escala
  box(width: 100%, height: 100%, clip: true, place(
    dx: (tira - ancho) * x - i * sz.width,
    dy: (sz.height - alto) * y,
    image(path, width: ancho, height: alto),
  ))
})

// Franja de cabecera o de pie: la marca va donde diga `donde` y el numero al
// borde contrario, asi nunca se pisan. Con la marca centrada el numero queda a
// la derecha y la columna izquierda vacia equilibra.
#let _bar(txt, num, donde) = {
  if donde == "left" {
    grid(columns: (auto, 1fr), align(left + horizon, txt), align(right + horizon, num))
  } else if donde == "right" {
    grid(columns: (auto, 1fr), align(left + horizon, num), align(right + horizon, txt))
  } else {
    grid(columns: (1fr, auto, 1fr),
      [], align(center + horizon, txt), align(right + horizon, num))
  }
}

// Un post = una pagina. pagecolor pinta el fondo; image-path lo cubre (fit cover).
// textcolor ya viene resuelto por el filtro. halign/valign viajan como string y
// no como alineacion de typst porque `left`/`center`/`top` son palabras del
// lenguaje y chocarian con los nombres de parametro.
#let _H = (left: left, center: center, right: right)
#let _V = (top: top, middle: horizon, bottom: bottom)

#let post(
  pagecolor: none,
  image-path: none,
  panorama-path: none,
  panorama-n: 1,
  panorama-i: 0,
  panorama-x: 50%,
  panorama-y: 50%,
  textcolor: rgb("#2d2d2d"),
  fontsize: none,
  leading: none,
  margin: none,
  halign: "center",
  valign: "middle",
  header: none,
  footer: none,
  show-header: true,
  show-footer: true,
  show-number: true,
  body,
) = {
  let marca(propia, global) = if propia != none { propia } else { global }
  page(
    width: _w, height: _h,
    margin: if margin != none { margin } else { _margin },
    fill: if pagecolor != none { pagecolor } else { white },
    background: if panorama-path != none {
      _panorama(panorama-path, panorama-n, panorama-i, x: panorama-x, y: panorama-y)
    } else if image-path != none {
      image(image-path, width: 100%, height: 100%, fit: "cover")
    },
    header: if show-header and marca(header, _header) != [] {
      set text(size: 0.72em, fill: textcolor)
      _bar(marca(header, _header), [], _header_align)
    },
    footer: if show-footer and (marca(footer, _footer) != [] or (_slidenum and show-number)) {
      context {
        set text(size: 0.72em, fill: textcolor)
        let num = if _slidenum and show-number {
          [#counter(page).get().first() / #counter(page).final().first()]
        } else { [] }
        _bar(marca(footer, _footer), num, _footer_align)
      }
    },
  )[
    #set text(fill: textcolor, size: if fontsize != none { fontsize } else { _fontsize })
    #set par(leading: if leading != none { leading } else { _leading })
    #align(_H.at(halign) + _V.at(valign))[#body]
  ]
}

$body$
