\documentclass$if(classoption)$[$for(classoption)$$classoption$$sep$,$endfor$]$endif${vgtc}
% Clase vgtc (IEEE VGTC, repo oficial vgtc_conference_latex, soporta los dos
% estilos): sin classoption compila el estilo conference final; con
% `classoption: [journal]` en el head.yaml, el estilo journal (TVCG / track
% journal de PacificVis); `review` (+ `onlineid`) para revision anonima y
% `preprint` para preprints. La opcion `electronic` es default de la clase, asi
% que hyperref, hypcap, xcolor[svgnames] y cleveref los carga \vgtcinsertpkg
% (no recargar xcolor aca: seria option clash).

% Tipografia que recomienda el template oficial: Times + txtt + mathptmx.
% amsmath va antes de \vgtcinsertpkg para que cleveref cargue despues de el.
\usepackage{times}
\renewcommand*\ttdefault{txtt}
\usepackage{mathptmx}
\usepackage{amsmath,amssymb}

% hyperref (cargado dentro de \vgtcinsertpkg) carga a su vez el paquete url;
% sin la opcion hyphens, url solo corta despues de / y no despues de -, asi
% que una URL con un slug largo unido por guiones (sin barras) se desborda de
% la columna en vez de cortarse.
\PassOptionsToPackage{hyphens}{url}
\vgtcinsertpkg

% ORCID junto al nombre. Esta version de vgtc.cls no define \authororcid, asi
% que se arma con el paquete orcidlink (dibuja el logo con tikz y necesita el
% hyperref que ya cargo \vgtcinsertpkg). Con \providecommand gana la definicion
% de la clase si alguna version la trae.
\usepackage{orcidlink}
\providecommand{\authororcid}[2]{#1~\orcidlink{#2}}

%% Metadatos del proceso de revision.
\onlineid{$if(onlineid)$$onlineid$$else$0$endif$}
\vgtccategory{$if(vgtccategory)$$vgtccategory$$else$Research$endif$}
$if(vgtcpapertype)$
\vgtcpapertype{$vgtcpapertype$}
$endif$

% Imagenes: la clase ya carga graphicx; esto es el ajuste a margenes que espera
% la salida de pandoc (\pandocbounded).
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{% scales image to fit line & page margins
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi% select the smaller of both
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox\pandoc@box%
  \fi%
}
\makeatother

% Tablas: el perfil convierte las tablas de pandoc en floats tabular
% (vgtc-tables.lua), porque longtable no compila en dos columnas. booktabs y
% array son lo que emite ese filtro; calc por las restas de longitudes del
% bloque citeproc (\linewidth - \csllabelwidth).
\usepackage{booktabs,array,calc}

% Empaquetado de floats mas permisivo que el default de LaTeX: en un paper
% denso de figuras (varios figure* y tables), los defaults dejan columnas a
% medio llenar y regalan paginas. Valores habituales para dos columnas.
\renewcommand{\topfraction}{0.9}
\renewcommand{\dbltopfraction}{0.9}
\renewcommand{\bottomfraction}{0.6}
\renewcommand{\textfraction}{0.07}
\renewcommand{\floatpagefraction}{0.85}
\renewcommand{\dblfloatpagefraction}{0.85}
\setcounter{topnumber}{3}
\setcounter{dbltopnumber}{3}
\setcounter{totalnumber}{5}

\providecommand{\tightlist}{%
\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

$if(csl-refs)$
% definitions for citeproc citations
\NewDocumentCommand\citeproctext{}{}
\NewDocumentCommand\citeproc{mm}{%
  \begingroup\def\citeproctext{#2}\cite{#1}\endgroup}
\makeatletter
 % allow citations to break across lines
 \let\@cite@ofmt\@firstofone
 % avoid brackets around text for \cite:
 \def\@biblabel#1{}
 \def\@cite#1#2{{#1\if@tempswa , #2\fi}}
\makeatother
\newlength{\cslhangindent}
\setlength{\cslhangindent}{1.5em}
\newlength{\csllabelwidth}
\setlength{\csllabelwidth}{3em}
% \scriptsize: el mismo tamano que vgtc.cls fija en su \thebibliography
\newenvironment{CSLReferences}[2] % #1 hanging-indent, #2 entry-spacing
 {\scriptsize\begin{list}{}{%
  \setlength{\itemindent}{0pt}
  \setlength{\leftmargin}{0pt}
  \setlength{\parsep}{0pt}
  % turn on hanging indent if param 1 is 1
  \ifodd #1
   \setlength{\leftmargin}{\cslhangindent}
   \setlength{\itemindent}{-1\cslhangindent}
  \fi
  % set entry spacing
  \setlength{\itemsep}{#2\baselineskip}}}
 {\end{list}}
\newcommand{\CSLBlock}[1]{\hfill\break\parbox[t]{\linewidth}{\strut\ignorespaces#1\strut}}
\newcommand{\CSLLeftMargin}[1]{\parbox[t]{\csllabelwidth}{\strut#1\strut}}
\newcommand{\CSLRightInline}[1]{\parbox[t]{\linewidth - \csllabelwidth}{\strut#1\strut}}
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}
$endif$

% preamble del usuario y de los filtros (p. ej. ulem/varwidth de fonts-and-alignment)
$for(header-includes)$
$header-includes$
$endfor$

$if(highlighting-macros)$
$highlighting-macros$
$endif$

\begin{document}

\title{$title$}

$if(anonymous)$
\author{Anonymous}
$else$
%% Las dos convenciones de autor de vgtc, elegidas con el \ifvgtcjournal de la
%% clase: en journal, \author lleva solo los nombres y las afiliaciones van
%% como oraciones en \authorfooter (pie de la primera pagina); en conference,
%% \authorfooter no se renderiza y cada autor lleva su e-mail en \thanks y su
%% afiliacion debajo del nombre (parbox, varias afiliaciones apiladas).
\ifvgtcjournal
\author{$for(authors)$$if(it.orcid)$\authororcid{$it.name$}{$it.orcid$}$else$$it.name$$endif$$sep$, $endfor$}
\authorfooter{
$for(authors)$
\item $it.name$ is with $for(it.affiliation)$$it$$sep$ and $endfor$.$if(it.email)$ E-mail: $it.email$.$endif$
$endfor$
}
\else
\author{$for(authors)$$if(it.orcid)$\authororcid{$it.name$}{$it.orcid$}$else$$it.name$$endif$$if(it.email)$\thanks{e-mail: $it.email$}$endif$\\ %
\parbox{2.4in}{\scriptsize\centering $for(it.affiliation)$$it$$sep$\\ $endfor$}$sep$ \and $endfor$}
\fi
$endif$

$if(abstract)$
\abstract{$abstract$}
$endif$

$if(keywords)$
\keywords{$for(keywords)$$it$$sep$, $endfor$}
$endif$

\maketitle

$for(include-before)$
$include-before$
$endfor$

$body$

$for(include-after)$
$include-after$
$endfor$
\end{document}
